# Copiá este archivo a .env (no se sube a git). Supabase ya apunta al proyecto de producción por defecto.
# EXPO_PUBLIC_SIN_LOGIN=1   # usar la app sin cuentas
# Client ID de tipo "Aplicación web" de Google Cloud (el mismo que cargás en Supabase → Auth → Google).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=xxxx.apps.googleusercontent.com

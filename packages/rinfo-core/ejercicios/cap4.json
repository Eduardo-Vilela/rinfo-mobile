          "aleatorio": {
            "zona": [
              1,
              1,
              100,
              100
            ],
            "flores": [
              0,
              3
            ],
            "papeles": [
              0,
              2
            ]
          },
          "flores": [
            [
              37,
              100,
              3
            ]
          ],
          "papeles": [
            [
              37,
              100,
              3
            ]
          ]
        },
        {
          "nombre": "en (1,1)",
          "flores": [
            [
              1,
              1,
              3
            ]
          ],
          "papeles": [
            [
              1,
              1,
              3
            ]
          ]
        }
      ],
      "validaciones": {
        "compararConReferencia": [
          "informa"
        ]
      },
      "solucion": [
        "programa Cap4Ej6",
        "areas",
        "  ciudad: AreaC(1,1,100,100)",
        "robots",
        "  robot robot1",
        "  variables",
        "    encontrada: boolean",
        "    pasos: numero",
        "    flores: numero",
        "    papeles: numero",
        "  comenzar",
        "    encontrada := F",
        "    pasos := 0",
        "    mientras ~encontrada",
        "      flores := 0",
        "      papeles := 0",
        "      mientras HayFlorEnLaEsquina",
        "        tomarFlor",
        "        flores := flores + 1",
        "      mientras HayPapelEnLaEsquina",
        "        tomarPapel",
        "        papeles := papeles + 1",
        "      si (flores = 3) & (papeles = 3)",
        "        encontrada := V",
        "      sino",
        "        si pasos = 99",
        "          derecha",
        "          pasos := 0",
        "        mover",
        "        pasos := pasos + 1",
        "    Informar(PosAv, PosCa)",
        "  fin",
        "variables",
        "  R-info: robot1",
        "comenzar",
        "  AsignarArea(R-info,ciudad)",
        "  Iniciar(R-info,1,1)",
        "fin"
      ],
      "notas": "Para contar hay que juntar, así que se compara solo lo que informa. Se informa la avenida y la calle."
    },

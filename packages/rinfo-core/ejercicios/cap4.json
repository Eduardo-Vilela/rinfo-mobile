    {
      "id": "c4-02",
      "modulo": "practicar",
      "tipo": "programa",
      "titulo": "Papeles en la calle 3 hasta quedarse sin",
      "tema": "iteracion",
      "dificultad": 2,
      "tiempoSugeridoMin": 15,
      "enunciado": "Programar al robot para que recorra la calle 3 desde la avenida 5 hasta la avenida 20 depositando un papel en cada esquina. Si durante el recorrido se queda sin papeles para depositar, debe detenerse.",
      "escenarios": [
        {
          "nombre": "alcanzan",
          "bolsa": {
            "papeles": 30
          }
        },
        {
          "nombre": "se queda sin papeles",
          "bolsa": {
            "papeles": 7
          }
        },
        {
          "nombre": "bolsa vacía"
        }
      ],
      "validaciones": {
        "compararConReferencia": [
          "ciudad"
        ]
      },
      "solucion": [
        "programa Cap4Ej2",
        "areas",
        "  ciudad: AreaC(1,1,100,100)",
        "robots",
        "  robot robot1",
        "  comenzar",
        "    Pos(5,3)",
        "    derecha",
        "    mientras HayPapelEnLaBolsa & (PosAv < 20)",
        "      depositarPapel",
        "      mover",
        "    si HayPapelEnLaBolsa",
        "      depositarPapel",
        "  fin",
        "variables",
        "  R-info: robot1",
        "comenzar",
        "  AsignarArea(R-info,ciudad)",
        "  Iniciar(R-info,1,1)",
        "fin"
      ],
      "notas": "Se compara solo cómo queda la calle: la esquina exacta donde se detiene el robot depende de si revisa la bolsa antes o después de moverse."
    },
    {
      "id": "c4-03",
      "modulo": "practicar",
      "tipo": "programa",
      "titulo": "Calle 45: una flor en pares, un papel en impares",
      "tema": "seleccion",
      "dificultad": 3,
      "tiempoSugeridoMin": 15,
      "enunciado": "Suponiendo que el robot cuenta con suficiente cantidad de flores y papeles en su bolsa, escribir un programa que le permita recorrer la calle 45 dejando en las avenidas pares solo una flor y en las impares solo un papel.",
      "escenarios": [
        {
          "aleatorio": {
            "zona": [
              1,
              45,
              100,
              45
            ],
            "flores": [
              0,
              2
            ],
            "papeles": [
              0,
              2
            ],
            "bolsa": {
              "flores": [
                100,
                100
              ],
              "papeles": [
                100,
                100
              ]
            }
          }
        }
      ],
      "validaciones": {
        "compararConReferencia": [
          "ciudad"
        ]
      },
      "solucion": [
        "programa Cap4Ej3",
        "areas",
        "  ciudad: AreaC(1,1,100,100)",
        "robots",
        "  robot robot1",
        "  variables",
        "    par: boolean",
        "  comenzar",
        "    par := F",
        "    Pos(1,45)",
        "    derecha",
        "    repetir 100",
        "      mientras HayFlorEnLaEsquina",
        "        tomarFlor",
        "      mientras HayPapelEnLaEsquina",
        "        tomarPapel",
        "      si par",
        "        depositarFlor",
        "      sino",
        "        depositarPapel",
        "      par := ~par",
        "      si PosAv < 100",
        "        mover",
        "  fin",
        "variables",
        "  R-info: robot1",
        "comenzar",
        "  AsignarArea(R-info,ciudad)",
        "  Iniciar(R-info,1,1)",
        "fin"
      ],
      "notas": "Interpretación: cada esquina termina con exactamente una flor (pares) o un papel (impares) y nada más. No existe operador de resto: la paridad se lleva con una variable boolean que se invierte en cada esquina."
    },
    {
      "id": "c4-04",
      "modulo": "practicar",
      "tipo": "programa",
      "titulo": "Calle 20: esquinas solo con flores y solo con papeles",
      "tema": "variables",
      "dificultad": 2,
      "tiempoSugeridoMin": 15,
      "enunciado": "Programar al robot para que recorra la calle 20 e informe cuántas esquinas tienen sólo flores y cuántas esquinas tienen sólo papeles.",
      "escenarios": [
        {
          "aleatorio": {
            "zona": [
              1,
              20,
              100,
              20
            ],
            "flores": [
              0,
              2
            ],
            "papeles": [
              0,
              2
            ]
          }
        }
      ],
      "validaciones": {
        "compararConReferencia": [
          "informa"
        ]
      },
      "solucion": [
        "programa Cap4Ej4",
        "areas",
        "  ciudad: AreaC(1,1,100,100)",
        "robots",
        "  robot robot1",
        "  variables",
        "    soloF: numero",
        "    soloP: numero",
        "  comenzar",
        "    soloF := 0",
        "    soloP := 0",
        "    Pos(1,20)",
        "    derecha",
        "    repetir 100",
        "      si HayFlorEnLaEsquina & ~HayPapelEnLaEsquina",
        "        soloF := soloF + 1",
        "      si HayPapelEnLaEsquina & ~HayFlorEnLaEsquina",
        "        soloP := soloP + 1",
        "      si PosAv < 100",
        "        mover",
        "    Informar(soloF, soloP)",
        "  fin",
        "variables",
        "  R-info: robot1",
        "comenzar",
        "  AsignarArea(R-info,ciudad)",
        "  Iniciar(R-info,1,1)",
        "fin"
      ],
      "notas": "Se informa primero la cantidad de esquinas con solo flores y después la de solo papeles."
    },
    {
      "id": "c4-05",
      "modulo": "practicar",
      "tipo": "programa",
      "titulo": "Perímetro: duplicar lo que está solo",
      "tema": "seleccion",
      "dificultad": 3,
      "tiempoSugeridoMin": 15,
      "enunciado": "Programar al robot para que recorra el perímetro de la ciudad dejando un papel en aquellas esquinas que sólo tienen papel y una flor en las esquinas que tienen sólo flores. El recorrido debe finalizar al terminar de recorrer el perímetro.",
      "escenarios": [
        {
          "aleatorio": {
            "zona": [
              1,
              1,
              100,
              100
            ],
            "flores": [
              0,
              1
            ],
            "papeles": [
              0,
              1
            ],
            "bolsa": {
              "flores": [
                400,
                400
              ],
              "papeles": [
                400,
                400
              ]
            }
          }
        }
      ],
      "validaciones": {
        "compararConReferencia": [
          "ciudad",
          "posicionFinal"
        ]
      },
      "solucion": [
        "programa Cap4Ej5",
        "areas",
        "  ciudad: AreaC(1,1,100,100)",
        "robots",
        "  robot robot1",
        "  comenzar",
        "    repetir 4",
        "      repetir 99",
        "        si HayPapelEnLaEsquina & ~HayFlorEnLaEsquina",
        "          depositarPapel",
        "        sino",
        "          si HayFlorEnLaEsquina & ~HayPapelEnLaEsquina",
        "            depositarFlor",
        "        mover",
        "      derecha",
        "  fin",
        "variables",
        "  R-info: robot1",
        "comenzar",
        "  AsignarArea(R-info,ciudad)",
        "  Iniciar(R-info,1,1)",
        "fin"
      ],
      "notas": "Se asume que la bolsa tiene suficientes flores y papeles. Cada vértice se procesa una sola vez."
    },
    {
      "id": "c4-06",
      "modulo": "practicar",
      "tipo": "programa",
      "titulo": "Perímetro: esquina con 3 flores y 3 papeles (existe)",
      "tema": "iteracion",
      "dificultad": 3,
      "tiempoSugeridoMin": 15,
      "enunciado": "Programar al robot para que recorra el perímetro de la ciudad buscando una esquina con exactamente 3 flores y 3 papeles, suponiendo que esta esquina existe. Debe informar cuál es la esquina encontrada.",
      "escenarios": [
        {
          "nombre": "en (100,40)",
          "aleatorio": {
            "zona": [
              1,
              1,
              100,
              100
            ],

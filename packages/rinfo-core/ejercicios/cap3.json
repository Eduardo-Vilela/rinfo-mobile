      "tiempoSugeridoMin": 10,
      "enunciado": "Programe al robot para que recorra la calle 2 hasta encontrar 10 papeles y 4 flores. Seguro existen dichas cantidades.",
      "escenarios": [
        {
          "aleatorio": {
            "zona": [
              1,
              2,
              100,
              2
            ],
            "flores": [
              0,
              1
            ],
            "papeles": [
              0,
              2
            ],

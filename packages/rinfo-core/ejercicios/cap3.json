    {
      "id": "c3-02a",
      "modulo": "practicar",
      "tipo": "programa",
      "titulo": "Contar flores de la calle 44 juntándolas",
      "tema": "variables",
      "dificultad": 2,
      "tiempoSugeridoMin": 10,
      "enunciado": "Programe al robot para que informe la cantidad de flores que hay en la calle 44, recogiendo todas las flores.",
      "escenarios": [
        {
          "aleatorio": {
            "zona": [
              1,
              44,
              100,
              44
            ],
            "flores": [
              0,
              4
            ]
          }
        }
      ],
      "validaciones": {
        "compararConReferencia": [
          "informa",
          "ciudad"
        ]
      },
      "solucion": [
        "programa Cap3Ej2a",
        "areas",
        "  ciudad: AreaC(1,1,100,100)",
        "robots",
        "  robot robot1",
        "  variables",
        "    flores: numero",
        "  comenzar",
        "    flores := 0",
        "    Pos(1,44)",
        "    derecha",
        "    repetir 100",
        "      mientras HayFlorEnLaEsquina",
        "        tomarFlor",
        "        flores := flores + 1",
        "      si PosAv < 100",
        "        mover",
        "    Informar(flores)",
        "  fin",
        "variables",
        "  R-info: robot1",
        "comenzar",
        "  AsignarArea(R-info,ciudad)",
        "  Iniciar(R-info,1,1)",
        "fin"
      ]
    },
    {
      "id": "c3-02b",
      "modulo": "practicar",
      "tipo": "programa",
      "titulo": "Contar flores de la calle 44 sin modificarla",
      "tema": "variables",
      "dificultad": 3,
      "tiempoSugeridoMin": 10,
      "enunciado": "Programe al robot para que informe la cantidad de flores que hay en la calle 44 sin modificar el contenido de cada esquina.",
      "escenarios": [
        {
          "aleatorio": {
            "zona": [
              1,
              44,
              100,
              44
            ],
            "flores": [
              0,
              4
            ],
            "bolsa": {
              "flores": [
                0,
                10
              ]
            }
          }
        }
      ],
      "validaciones": {
        "compararConReferencia": [
          "informa",
          "ciudad"
        ]
      },
      "solucion": [
        "programa Cap3Ej2b",
        "areas",
        "  ciudad: AreaC(1,1,100,100)",
        "robots",
        "  robot robot1",
        "  variables",
        "    flores: numero",
        "    enEsquina: numero",
        "  comenzar",
        "    flores := 0",
        "    Pos(1,44)",
        "    derecha",
        "    repetir 100",
        "      enEsquina := 0",
        "      mientras HayFlorEnLaEsquina",
        "        tomarFlor",
        "        enEsquina := enEsquina + 1",
        "      flores := flores + enEsquina",
        "      repetir enEsquina",
        "        depositarFlor",
        "      si PosAv < 100",
        "        mover",
        "    Informar(flores)",
        "  fin",
        "variables",
        "  R-info: robot1",
        "comenzar",
        "  AsignarArea(R-info,ciudad)",
        "  Iniciar(R-info,1,1)",
        "fin"
      ],
      "notas": "El escenario arranca con flores en la bolsa a propósito: si la solución devuelve 'todas las flores de la bolsa' en lugar de las que juntó en la esquina, modifica la ciudad y no pasa."
    },
    {
      "id": "c3-03",
      "modulo": "practicar",
      "tipo": "programa",
      "titulo": "Esquinas vacías de la ciudad",
      "tema": "variables",
      "dificultad": 3,
      "tiempoSugeridoMin": 15,
      "enunciado": "Programe al robot para que informe la cantidad de esquinas vacías que hay en la ciudad.",
      "escenarios": [
        {
          "aleatorio": {
            "zona": [
              1,
              1,
              100,
              100
            ],
            "flores": [
              0,
              1
            ],
            "papeles": [
              0,
              1
            ]
          }
        }
      ],
      "validaciones": {
        "compararConReferencia": [
          "informa"
        ]
      },
      "solucion": [
        "programa Cap3Ej3",
        "areas",
        "  ciudad: AreaC(1,1,100,100)",
        "robots",
        "  robot robot1",
        "  variables",
        "    vacias: numero",
        "  comenzar",
        "    vacias := 0",
        "    repetir 100",
        "      repetir 100",
        "        si ~(HayFlorEnLaEsquina | HayPapelEnLaEsquina)",
        "          vacias := vacias + 1",
        "        si PosCa < 100",
        "          mover",
        "      si PosAv < 100",
        "        Pos(PosAv + 1, 1)",
        "    Informar(vacias)",
        "  fin",
        "variables",
        "  R-info: robot1",
        "comenzar",
        "  AsignarArea(R-info,ciudad)",
        "  Iniciar(R-info,1,1)",
        "fin"
      ]
    },

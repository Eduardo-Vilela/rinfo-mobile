    {
      "id": "c3-01a",
      "modulo": "aprender",
      "tipo": "queHace",
      "titulo": "¿Qué hace queHace1?",
      "tema": "iteracion",
      "dificultad": 2,
      "enunciado": "Indique qué hace el programa en cada situación.",
      "programa": [
        "programa queHace1",
        "areas",
        "  ciudad: AreaC(1,1,100,100)",
        "robots",
        "  robot robot1",
        "  comenzar",
        "    Pos(6,1)",
        "    mientras ((HayFlorEnLaEsquina) & (PosCa < 100))",
        "      mover",
        "      tomarFlor",
        "  fin",
        "variables",
        "  R-info: robot1",
        "comenzar",
        "  AsignarArea(R-info,ciudad)",
        "  Iniciar(R-info,1,1)",
        "fin"
      ],
      "preguntas": [
        "posicionFinal",
        "informa",
        "error"
      ],
      "escenarios": [
        {
          "nombre": "todas las esquinas de la avenida 6 tienen 1 flor",
          "aleatorio": {
            "zona": [
              6,
              1,
              6,
              100
            ],
            "flores": [
              1,
              1
            ]
          }
        },
        {
          "nombre": "todas las esquinas de la avenida 6 tienen 2 o más flores",
          "aleatorio": {
            "zona": [
              6,
              1,
              6,
              100
            ],
            "flores": [
              2,
              5
            ]
          }
        },
        {
          "nombre": "solo (6,20) tiene flor",
          "flores": [
            [
              6,
              20,
              1
            ]
          ]
        },
        {
          "nombre": "ninguna esquina de la avenida 6 tiene flor"
        }
      ],
      "notas": "El material dice 'al menos 1 flor'. Separé el escenario en 1 flor y 2 o más porque el resultado cambia: con una sola flor por esquina el robot se detiene en (6,2). Las respuestas no se escriben a mano: el grader las calcula ejecutando el programa."
    },
    {
      "id": "c3-01b",
      "modulo": "aprender",
      "tipo": "queHace",
      "titulo": "¿Qué hace queHace2?",
      "tema": "variables",
      "dificultad": 2,
      "enunciado": "Indique qué hace el programa en cada situación.",
      "programa": [
        "programa queHace2",
        "areas",
        "  ciudad: AreaC(1,1,100,100)",
        "robots",
        "  robot robot1",
        "  variables",
        "    nro: numero",
        "  comenzar",
        "    nro := 0",
        "    repetir 10",
        "      si ~((HayFlorEnLaEsquina) | (HayPapelEnLaEsquina))",
        "        mover",
        "        nro := nro + 1",
        "    Informar(nro)",
        "  fin",
        "variables",
        "  R-info: robot1",
        "comenzar",
        "  AsignarArea(R-info,ciudad)",
        "  Iniciar(R-info,1,1)",
        "fin"
      ],
      "preguntas": [
        "posicionFinal",
        "informa",
        "error"
      ],

  "ejercicios": [
    {
      "id": "c2-01",
      "modulo": "practicar",
      "tipo": "programa",
      "titulo": "Flor en (2,84)",
      "tema": "seleccion",
      "dificultad": 1,
      "tiempoSugeridoMin": 10,
      "enunciado": "Escriba un programa que le permita al robot recoger una flor de la esquina (2,84) si existe.",
      "escenarios": [
        {
          "nombre": "con flor",
          "flores": [
            [
              2,
              84,
              3
            ]
          ]
        },
        {
          "nombre": "sin flor"
        }
      ],
      "validaciones": {
        "compararConReferencia": [
          "posicionFinal",
          "ciudad",
          "bolsa"
        ]
      },
      "solucion": [
        "programa Cap2Ej1",
        "areas",
        "  ciudad: AreaC(1,1,100,100)",
        "robots",
        "  robot robot1",
        "  comenzar",
        "    Pos(2,84)",
        "    si HayFlorEnLaEsquina",
        "      tomarFlor",
        "  fin",
        "variables",
        "  R-info: robot1",
        "comenzar",
        "  AsignarArea(R-info,ciudad)",
        "  Iniciar(R-info,1,1)",
        "fin"
      ]
    },
    {
      "id": "c2-02",
      "modulo": "practicar",
      "tipo": "programa",
      "titulo": "Papeles en la calle 50",
      "tema": "repeticion",
      "dificultad": 2,
      "tiempoSugeridoMin": 10,
      "enunciado": "Escriba un programa que le permita al robot recorrer la calle 50 desde la avenida 65 hasta la avenida 23 depositando un papel en cada esquina. Debe avanzar hasta el final aunque durante el recorrido se quede sin papeles.",
      "escenarios": [
        {
          "nombre": "papeles de sobra",
          "bolsa": {
            "papeles": 60
          }
        },
        {
          "nombre": "se queda sin papeles",
          "bolsa": {
            "papeles": 10
          }
        },
        {
          "nombre": "bolsa vacía"
        }
      ],
      "validaciones": {
        "compararConReferencia": [
          "posicionFinal",
          "ciudad"
        ]
      },
      "solucion": [
        "programa Cap2Ej2",
        "areas",
        "  ciudad: AreaC(1,1,100,100)",
        "robots",
        "  robot robot1",
        "  comenzar",
        "    Pos(65,50)",
        "    repetir 3",
        "      derecha",
        "    repetir 42",
        "      si HayPapelEnLaBolsa",
        "        depositarPapel",
        "      mover",
        "    si HayPapelEnLaBolsa",
        "      depositarPapel",
        "  fin",
        "variables",
        "  R-info: robot1",
        "comenzar",
        "  AsignarArea(R-info,ciudad)",
        "  Iniciar(R-info,1,1)",
        "fin"
      ],
      "notas": "Para mirar al oeste hay que girar 3 veces a la derecha. De la avenida 65 a la 23 hay 43 esquinas y 42 cuadras."
    },

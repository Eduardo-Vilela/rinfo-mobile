    {
      "id": "c2-10",
      "modulo": "practicar",
      "tipo": "programa",
      "titulo": "Limpiar las 5 primeras avenidas",
      "tema": "repeticion",
      "dificultad": 3,
      "tiempoSugeridoMin": 15,
      "enunciado": "Programe al robot para que recorra las 5 primeras avenidas juntando en cada esquina todas las flores y papeles.",
      "escenarios": [
        {
          "aleatorio": {
            "zona": [
              1,
              1,
              5,
              100
            ],
            "flores": [
              0,
              3
            ],
            "papeles": [
              0,
              3
            ]
          }
        }
      ],
      "validaciones": {
        "compararConReferencia": [
          "ciudad",
          "bolsa"
        ]
      },
      "solucion": [
        "programa Cap2Ej10",
        "areas",
        "  ciudad: AreaC(1,1,100,100)",
        "robots",
        "  robot robot1",
        "  comenzar",
        "    repetir 5",
        "      repetir 100",
        "        mientras HayFlorEnLaEsquina",
        "          tomarFlor",
        "        mientras HayPapelEnLaEsquina",
        "          tomarPapel",
        "        si PosCa < 100",
        "          mover",
        "      si PosAv < 5",
        "        Pos(PosAv + 1, 1)",
        "  fin",
        "variables",
        "  R-info: robot1",
        "comenzar",
        "  AsignarArea(R-info,ciudad)",
        "  Iniciar(R-info,1,1)",
        "fin"
      ]
    },
    {
      "id": "c2-11",
      "modulo": "practicar",
      "tipo": "programa",
      "titulo": "Perímetro de la ciudad con un papel por vértice",
      "tema": "iteracion",
      "dificultad": 3,
      "tiempoSugeridoMin": 15,
      "enunciado": "Programe al robot para que recorra el perímetro de la ciudad recogiendo todas las flores y papeles que encuentre y dejando en cada vértice solo un papel. Puede ocurrir que algún vértice quede vacío si el robot no tiene papeles en su bolsa para depositar.",
      "escenarios": [
        {
          "aleatorio": {
            "zona": [
              1,
              1,
              100,
              100
            ],
            "flores": [
              0,
              2
            ],
            "papeles": [
              0,
              2
            ]
          }
        },
        {
          "nombre": "sin papeles en ningún lado"
        }
      ],
      "validaciones": {
        "compararConReferencia": [
          "posicionFinal",
          "ciudad",
          "bolsa"
        ]
      },
      "solucion": [
        "programa Cap2Ej11",
        "areas",
        "  ciudad: AreaC(1,1,100,100)",
        "robots",
        "  robot robot1",
        "  comenzar",
        "    repetir 4",
        "      mientras HayFlorEnLaEsquina",
        "        tomarFlor",
        "      mientras HayPapelEnLaEsquina",
        "        tomarPapel",
        "      si HayPapelEnLaBolsa",
        "        depositarPapel",
        "      repetir 98",
        "        mover",
        "        mientras HayFlorEnLaEsquina",
        "          tomarFlor",
        "        mientras HayPapelEnLaEsquina",
        "          tomarPapel",
        "      mover",
        "      derecha",
        "  fin",
        "variables",
        "  R-info: robot1",
        "comenzar",
        "  AsignarArea(R-info,ciudad)",
        "  Iniciar(R-info,1,1)",
        "fin"
      ]
    },
    {
      "id": "c2-12",
      "modulo": "practicar",
      "tipo": "programa",
      "titulo": "Un papel en cada esquina vacía",
      "tema": "seleccion",
      "dificultad": 3,
      "tiempoSugeridoMin": 15,
      "enunciado": "Programe al robot para que recorra todas las calles depositando en cada esquina vacía un papel. En caso de no tener más papeles debe continuar el recorrido (sin depositar).",
      "escenarios": [
        {
          "aleatorio": {
            "zona": [
              1,
              1,
              100,
              100
            ],
            "flores": [
              0,
              1
            ],
            "papeles": [
              0,
              1
            ],
            "bolsa": {
              "papeles": [
                0,
                3000
              ]
            }
          }
        }
      ],
      "validaciones": {
        "compararConReferencia": [
          "ciudad",
          "bolsa"
        ]
      },
      "solucion": [
        "programa Cap2Ej12",
        "areas",
        "  ciudad: AreaC(1,1,100,100)",
        "robots",
        "  robot robot1",
        "  comenzar",
        "    derecha",
        "    repetir 100",
        "      repetir 100",
        "        si (~HayFlorEnLaEsquina) & (~HayPapelEnLaEsquina) & HayPapelEnLaBolsa",
        "          depositarPapel",
        "        si PosAv < 100",
        "          mover",
        "      si PosCa < 100",
        "        Pos(1, PosCa + 1)",
        "  fin",
        "variables",
        "  R-info: robot1",
        "comenzar",
        "  AsignarArea(R-info,ciudad)",
        "  Iniciar(R-info,1,1)",
        "fin"
      ]
    }
  ]
}
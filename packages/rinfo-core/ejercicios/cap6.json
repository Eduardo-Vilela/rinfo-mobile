    {
      "id": "c6-07",
      "modulo": "practicar",
      "tipo": "programa",
      "titulo": "CalleFlor",
      "tema": "parametrosE",
      "dificultad": 3,
      "tiempoSugeridoMin": 15,
      "enunciado": "Programe al robot para que realice un módulo CalleFlor que recorra una calle cuyo número se ingresa como parámetro, hasta juntar tantas flores como lo indica otro parámetro de entrada que este módulo recibe. La cantidad de flores seguro existe. Usalo para juntar 10 flores en la calle 5 y después 3 flores en la calle 30.",
      "escenarios": [
        {
          "aleatorio": {
            "zona": [
              1,
              1,
              100,
              100
            ],
            "flores": [
              0,
              2
            ],
            "densidad": {
              "flores": 0.3
            },
            "restricciones": [
              {
                "zona": [
                  1,
                  5,
                  100,
                  5
                ],
                "totalFlores": {
                  "min": 10
                }
              },
              {
                "zona": [
                  1,
                  30,
                  100,
                  30
                ],
                "totalFlores": {
                  "min": 3
                }
              }
            ]
          }
        }
      ],
      "validaciones": {
        "compararConReferencia": [
          "ciudad",
          "bolsa",
          "posicionFinal"
        ],
        "usa": {
          "procesosMin": 1,
          "parametros": [
            "E"
          ]
        }
      },
      "solucion": [
        "programa Cap6Ej7",
        "procesos",
        "  proceso CalleFlor(E calle: numero; E cant: numero)",
        "  variables",
        "    juntadas: numero",
        "  comenzar",
        "    Pos(1,calle)",
        "    juntadas := 0",
        "    mientras juntadas < cant",
        "      mientras HayFlorEnLaEsquina & (juntadas < cant)",
        "        tomarFlor",
        "        juntadas := juntadas + 1",
        "      si juntadas < cant",
        "        mover",
        "  fin",
        "areas",
        "  ciudad: AreaC(1,1,100,100)",
        "robots",
        "  robot robot1",
        "  comenzar",
        "    derecha",
        "    CalleFlor(5, 10)",
        "    CalleFlor(30, 3)",
        "  fin",
        "variables",
        "  R-info: robot1",
        "comenzar",
        "  AsignarArea(R-info,ciudad)",
        "  Iniciar(R-info,1,1)",
        "fin"
      ],
      "notas": "El robot gira una sola vez al principio para mirar al este; el proceso asume que ya mira hacia ese lado. Junta flor por flor, así deja en la ciudad las que sobran."
    },
    {
      "id": "c6-08",
      "modulo": "practicar",
      "tipo": "programa",
      "titulo": "Avenida con cantidad de pasos",
      "tema": "parametrosE",
      "dificultad": 3,
      "tiempoSugeridoMin": 15,
      "enunciado": "Programe al robot para que realice un módulo Avenida que recorra una avenida, cuyo número se ingresa como parámetro, hasta dar tantos pasos como los indicados por otro parámetro de entrada. Si recibe algún valor negativo no debe dar pasos. La cantidad máxima de pasos es 99: cualquier valor mayor implica dar solo 99 pasos. Probalo con (3,1), (12,5), (20,-4) y (40,150).",
      "escenarios": [
        {
          "nombre": "ciudad vacía"
        }
      ],
      "validaciones": {
        "compararConReferencia": [
          "recorrido"
        ],
        "usa": {
          "procesosMin": 1,
          "parametros": [
            "E"
          ]
        }
      },
      "solucion": [
        "programa Cap6Ej8",
        "procesos",
        "  proceso Avenida(E av: numero; E pasos: numero)",
        "  variables",
        "    n: numero",
        "  comenzar",
        "    Pos(av,1)",
        "    n := pasos",
        "    si n > 99",
        "      n := 99",
        "    si n > 0",
        "      repetir n",
        "        mover",
        "  fin",
        "areas",
        "  ciudad: AreaC(1,1,100,100)",
        "robots",
        "  robot robot1",
        "  comenzar",
        "    Avenida(3, 1)",
        "    Avenida(12, 5)",
        "    Avenida(20, -4)",
        "    Avenida(40, 150)",
        "  fin",
        "variables",
        "  R-info: robot1",
        "comenzar",
        "  AsignarArea(R-info,ciudad)",
        "  Iniciar(R-info,1,1)",
        "fin"
      ],
      "notas": "No se puede asignar a un parámetro E: el valor se copia a una variable local antes de corregirlo."
    }
  ]
}
    {
      "id": "c6-06d",
      "modulo": "practicar",
      "tipo": "programa",
      "titulo": "Recorrer avenidas pares",
      "tema": "parametrosE",
      "dificultad": 2,
      "tiempoSugeridoMin": 10,
      "enunciado": "(a) Escriba un proceso que le permita al robot recorrer una avenida cuyo número se ingresa como parámetro de entrada. Utilícelo para recorrer las avenidas pares de la ciudad.",
      "escenarios": [
        {
          "nombre": "ciudad vacía"
        }
      ],
      "validaciones": {
        "compararConReferencia": [
          "recorrido"
        ],
        "usa": {
          "procesosMin": 1,
          "parametros": [
            "E"
          ]
        }
      },
      "solucion": [
        "programa Cap6Ej6d",
        "procesos",

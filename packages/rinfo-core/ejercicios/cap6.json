{
  "capitulo": "Capítulo 6 – Parámetros de Entrada",
  "version": 1,
  "ejercicios": [
    {
      "id": "c6-01",
      "modulo": "practicar",
      "tipo": "programa",
      "titulo": "Cuadrado de lado variable",
      "tema": "parametrosE",
      "dificultad": 2,
      "tiempoSugeridoMin": 10,
      "enunciado": "Escriba un proceso que le permita al robot realizar un cuadrado a partir de la esquina donde está parado, girando en la dirección de las agujas del reloj y recibiendo como dato la longitud del lado. Probalo haciendo un cuadrado de lado 4 desde (1,1) y otro de lado 7 desde (20,20).",
      "escenarios": [
        {
          "nombre": "ciudad vacía"
        }
      ],
      "validaciones": {
        "compararConReferencia": [
          "recorrido"
        ],
        "usa": {
          "procesosMin": 1,
          "parametros": [
            "E"
          ]
        }
      },
      "solucion": [
        "programa Cap6Ej1",
        "procesos",
        "  proceso Cuadrado(E lado: numero)",
        "  comenzar",
        "    repetir 4",
        "      repetir lado",
        "        mover",
        "      derecha",
        "  fin",
        "areas",
        "  ciudad: AreaC(1,1,100,100)",
        "robots",
        "  robot robot1",
        "  comenzar",
        "    Cuadrado(4)",
        "    Pos(20,20)",
        "    Cuadrado(7)",
        "  fin",
        "variables",
        "  R-info: robot1",
        "comenzar",
        "  AsignarArea(R-info,ciudad)",
        "  Iniciar(R-info,1,1)",
        "fin"
      ]
    },
    {
      "id": "c6-03",
      "modulo": "practicar",
      "tipo": "programa",
      "titulo": "Rectángulo de alto y ancho variables",
      "tema": "parametrosE",
      "dificultad": 2,
      "tiempoSugeridoMin": 10,
      "enunciado": "Escriba un proceso que le permita al robot realizar un rectángulo a partir de la esquina donde está parado cuyas dimensiones, alto y ancho, se reciben. Probalo con alto 3 y ancho 5 desde (1,1), y con alto 6 y ancho 2 desde (10,10).",
      "escenarios": [
        {
          "nombre": "ciudad vacía"
        }
      ],
      "validaciones": {
        "compararConReferencia": [
          "recorrido"
        ],
        "usa": {
          "procesosMin": 1,
          "parametros": [
            "E"
          ]
        }
      },
      "solucion": [
        "programa Cap6Ej3",
        "procesos",
        "  proceso Rectangulo(E alto: numero; E ancho: numero)",
        "  comenzar",
        "    repetir 2",
        "      repetir alto",
        "        mover",
        "      derecha",
        "      repetir ancho",
        "        mover",
        "      derecha",
        "  fin",
        "areas",
        "  ciudad: AreaC(1,1,100,100)",
        "robots",
        "  robot robot1",
        "  comenzar",
        "    Rectangulo(3,5)",
        "    Pos(10,10)",
        "    Rectangulo(6,2)",
        "  fin",
        "variables",
        "  R-info: robot1",
        "comenzar",
        "  AsignarArea(R-info,ciudad)",
        "  Iniciar(R-info,1,1)",
        "fin"
      ],
      "notas": "Gira en sentido horario: primero sube el alto, después avanza el ancho."
    },
    {
      "id": "c6-06b",
      "modulo": "practicar",
      "tipo": "programa",
      "titulo": "Recorrer todas las avenidas",
      "tema": "parametrosE",
      "dificultad": 2,
      "tiempoSugeridoMin": 10,
      "enunciado": "(a) Escriba un proceso que le permita al robot recorrer una avenida cuyo número se ingresa como parámetro de entrada. Utilícelo para recorrer todas las avenidas de la ciudad.",
      "escenarios": [
        {
          "nombre": "ciudad vacía"
        }
      ],
      "validaciones": {
        "compararConReferencia": [
          "recorrido"
        ],
        "usa": {
          "procesosMin": 1,
          "parametros": [
            "E"
          ]
        }
      },
      "solucion": [
        "programa Cap6Ej6b",
        "procesos",
        "  proceso RecorrerAvenida(E av: numero)",
        "  comenzar",
        "    Pos(av,1)",
        "    repetir 99",
        "      mover",
        "  fin",
        "areas",
        "  ciudad: AreaC(1,1,100,100)",
        "robots",
        "  robot robot1",
        "  variables",
        "    a: numero",
        "  comenzar",
        "    a := 1",
        "    repetir 100",
        "      RecorrerAvenida(a)",
        "      a := a + 1",
        "  fin",
        "variables",
        "  R-info: robot1",
        "comenzar",
        "  AsignarArea(R-info,ciudad)",
        "  Iniciar(R-info,1,1)",
        "fin"
      ]
    },
    {
      "id": "c6-06c",

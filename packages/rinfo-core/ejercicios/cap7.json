      "solucion": [
        "programa Cap7Ej5",
        "procesos",
        "  proceso Buscar(ES pasos: numero)",
        "  comenzar",
        "    pasos := 0",
        "    mientras ~(HayFlorEnLaEsquina | HayPapelEnLaEsquina)",
        "      mover",
        "      pasos := pasos + 1",
        "  fin",
        "areas",
        "  ciudad: AreaC(1,1,100,100)",
        "robots",
        "  robot robot1",
        "  variables",
        "    c: numero",
        "    pasos: numero",
        "  comenzar",
        "    c := 1",
        "    derecha",
        "    repetir 50",
        "      Pos(1,c)",

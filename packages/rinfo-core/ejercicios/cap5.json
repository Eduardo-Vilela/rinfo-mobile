  "version": 1,
  "ejercicios": [
    {
      "id": "c5-01",
      "modulo": "practicar",
      "tipo": "programa",
      "titulo": "Proceso cuadrado de lado 2",
      "tema": "procesos",
      "dificultad": 1,
      "tiempoSugeridoMin": 10,
      "enunciado": "Escriba un proceso que le permita al robot realizar un cuadrado de lado 2 girando en la dirección de las agujas del reloj. Usalo para hacer el cuadrado desde (1,1).",
      "escenarios": [
        {
          "nombre": "ciudad vacía"
        }
      ],
      "validaciones": {
        "compararConReferencia": [
          "recorrido"
        ],
        "usa": {
          "procesosMin": 1
        }
      },
      "solucion": [
        "programa Cap5Ej1",
        "procesos",
        "  proceso Cuadrado",
        "  comenzar",
        "    repetir 4",
        "      repetir 2",
        "        mover",
        "      derecha",
        "  fin",
        "areas",
        "  ciudad: AreaC(1,1,100,100)",
        "robots",
        "  robot robot1",
        "  comenzar",
        "    Cuadrado",
        "  fin",
        "variables",
        "  R-info: robot1",
        "comenzar",
        "  AsignarArea(R-info,ciudad)",
        "  Iniciar(R-info,1,1)",
        "fin"
      ]
    },
    {
      "id": "c5-03",
      "modulo": "practicar",
      "tipo": "programa",
      "titulo": "Proceso rectángulo de 5 x 3",
      "tema": "procesos",
      "dificultad": 2,
      "tiempoSugeridoMin": 10,
      "enunciado": "Escriba un proceso que le permita al robot realizar un rectángulo de base 5 y altura 3 girando en la dirección de las agujas del reloj a partir de la posición (1,1).",
      "escenarios": [
        {
          "nombre": "ciudad vacía"
        }
      ],
      "validaciones": {
        "compararConReferencia": [
          "recorrido"
        ],
        "usa": {
          "procesosMin": 1
        }
      },
      "solucion": [
        "programa Cap5Ej3",
        "procesos",
        "  proceso Rectangulo",
        "  comenzar",
        "    repetir 2",
        "      repetir 3",
        "        mover",
        "      derecha",
        "      repetir 5",
        "        mover",
        "      derecha",
        "  fin",
        "areas",
        "  ciudad: AreaC(1,1,100,100)",
        "robots",
        "  robot robot1",
        "  comenzar",
        "    Rectangulo",
        "  fin",
        "variables",
        "  R-info: robot1",
        "comenzar",
        "  AsignarArea(R-info,ciudad)",
        "  Iniciar(R-info,1,1)",
        "fin"
      ],
      "notas": "Base = cuadras hacia el este (5), altura = cuadras hacia el norte (3). Arranca mirando al norte."
    },
    {
      "id": "c5-06a",
      "modulo": "practicar",
      "tipo": "programa",
      "titulo": "Rectángulo de 5 x 3 antihorario",
      "tema": "procesos",
      "dificultad": 2,
      "tiempoSugeridoMin": 10,
      "enunciado": "Escriba un proceso que le permita al robot realizar un rectángulo de base 5 y altura 3 girando en la dirección contraria a la de las agujas del reloj, a partir de (1,1).",
      "escenarios": [
        {
          "nombre": "ciudad vacía"
        }
      ],
      "validaciones": {
        "compararConReferencia": [
          "recorrido"
        ],
        "usa": {
          "procesosMin": 1
        }
      },
      "solucion": [
        "programa Cap5Ej6a",
        "procesos",
        "  proceso Izquierda",
        "  comenzar",
        "    repetir 3",
        "      derecha",
        "  fin",
        "  proceso RectanguloAntihorario",
        "  comenzar",
        "    derecha",
        "    repetir 2",
        "      repetir 5",
        "        mover",
        "      Izquierda",
        "      repetir 3",
        "        mover",
        "      Izquierda",
        "    Izquierda",
        "  fin",
        "areas",
        "  ciudad: AreaC(1,1,100,100)",
        "robots",
        "  robot robot1",
        "  comenzar",
        "    RectanguloAntihorario",
        "  fin",
        "variables",
        "  R-info: robot1",
        "comenzar",
        "  AsignarArea(R-info,ciudad)",
        "  Iniciar(R-info,1,1)",
        "fin"
      ],
      "notas": "El robot no tiene 'izquierda': se gira 3 veces a la derecha. Desde (1,1) el sentido antihorario arranca hacia el este."
    },
    {
      "id": "c5-07b",
      "modulo": "practicar",
      "tipo": "programa",
      "titulo": "LimpiarEsquina en la avenida 89",
      "tema": "procesos",
      "dificultad": 2,
      "tiempoSugeridoMin": 15,
      "enunciado": "(a) Escriba el proceso LimpiarEsquina que le permita al robot recoger todas las flores y todos los papeles de la esquina donde se encuentra parado. (b) Escriba un programa que le permita al robot recoger todas las flores y papeles de la avenida 89, utilizando ese proceso.",
      "escenarios": [
        {
          "aleatorio": {
            "zona": [
              89,
              1,
              89,
              100
            ],
            "flores": [
              0,
              3
            ],
            "papeles": [
              0,
              3
            ]
          }
        }
      ],
      "validaciones": {
        "compararConReferencia": [
          "ciudad",
          "bolsa"
        ],
        "usa": {
          "procesosMin": 1
        }
      },
      "solucion": [
        "programa Cap5Ej7b",
        "procesos",
        "  proceso LimpiarEsquina",
        "  comenzar",
        "    mientras HayFlorEnLaEsquina",
        "      tomarFlor",
        "    mientras HayPapelEnLaEsquina",
        "      tomarPapel",
        "  fin",
        "areas",
        "  ciudad: AreaC(1,1,100,100)",
        "robots",
        "  robot robot1",
        "  comenzar",
        "    Pos(89,1)",
        "    repetir 99",
        "      LimpiarEsquina",
        "      mover",
        "    LimpiarEsquina",
        "  fin",
        "variables",
        "  R-info: robot1",
        "comenzar",
        "  AsignarArea(R-info,ciudad)",
        "  Iniciar(R-info,1,1)",
        "fin"
      ]
    },
    {
      "id": "c5-07c",
      "modulo": "practicar",
      "tipo": "programa",
      "titulo": "Rectángulo antihorario limpiando",
      "tema": "procesos",
      "dificultad": 3,
      "tiempoSugeridoMin": 15,
      "enunciado": "Modifique el proceso del rectángulo antihorario (6.a) para que el robot realice el rectángulo dejando a su paso todas las esquinas vacías. Debe utilizar el proceso LimpiarEsquina.",

                  1,
                  1,
                  100
                ],
                "totalFlores": {
                  "min": 30
                }
              }
            ]
          }
        },
        {
          "aleatorio": {
            "zona": [
              1,
              1,
              1,
              100
            ],
            "flores": [
              0,
              1
            ],
            "restricciones": [
              {
                "zona": [
                  1,
                  1,
                  1,
                  100
                ],
                "totalFlores": {
                  "max": 25
                }
              }
            ]
          }
        }
      ],
      "validaciones": {
        "compararConReferencia": [
          "posicionFinal",
          "bolsa"
        ],
        "usa": {
          "procesosMin": 1
        }
      },
      "solucion": [
        "programa Cap5Ej9b",
        "procesos",
        "  proceso Juntar30",
        "  variables",
        "    cant: numero",
        "  comenzar",
        "    cant := 0",
        "    mientras (cant < 30) & (PosCa < 100)",
        "      mientras HayFlorEnLaEsquina & (cant < 30)",
        "        tomarFlor",
        "        cant := cant + 1",
        "      si cant < 30",
        "        mover",
        "    mientras HayFlorEnLaEsquina & (cant < 30)",
        "      tomarFlor",
        "      cant := cant + 1",
        "  fin",
        "areas",
        "  ciudad: AreaC(1,1,100,100)",
        "robots",
        "  robot robot1",
        "  comenzar",
        "    Juntar30",
        "  fin",
        "variables",
        "  R-info: robot1",
        "comenzar",
        "  AsignarArea(R-info,ciudad)",
        "  Iniciar(R-info,1,1)",
        "fin"
      ]
    },

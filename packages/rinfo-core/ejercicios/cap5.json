        "        LimpiarEsquina",
        "        mover",
        "      Izquierda",
        "    Izquierda",
        "  fin",
        "areas",
        "  ciudad: AreaC(1,1,100,100)",
        "robots",
        "  robot robot1",
        "  comenzar",
        "    RectanguloLimpiando",
        "  fin",
        "variables",
        "  R-info: robot1",
        "comenzar",
        "  AsignarArea(R-info,ciudad)",
        "  Iniciar(R-info,1,1)",
        "fin"
      ]
    },
    {
      "id": "c5-08",
      "modulo": "practicar",
      "tipo": "programa",
      "titulo": "Avenida y calle alternadas",
      "tema": "procesos",
      "dificultad": 3,
      "tiempoSugeridoMin": 20,
      "enunciado": "Programe al robot para que recorra la ciudad de la siguiente manera: primero debe recorrer la avenida 1 juntando todas las flores que encuentre, luego debe recorrer la calle 1 juntando todos los papeles que encuentre. Luego recorre la avenida 2 y la calle 2 de la misma manera y así siguiendo. Implemente un módulo para recorrer la avenida y otro módulo para recorrer la calle.",
      "escenarios": [
        {
          "aleatorio": {
            "zona": [
              1,
              1,
              100,
              100
            ],
            "flores": [
              0,
              1
            ],
            "papeles": [
              0,
              1
            ],
            "densidad": {
              "flores": 0.2,
              "papeles": 0.2
            }
          }
        }
      ],
      "validaciones": {
        "compararConReferencia": [
          "ciudad",
          "bolsa"
        ],
        "usa": {
          "procesosMin": 2
        }
      },
      "solucion": [
        "programa Cap5Ej8",
        "procesos",
        "  proceso JuntarFloresAvenida",
        "  comenzar",
        "    repetir 99",
        "      mientras HayFlorEnLaEsquina",
        "        tomarFlor",
        "      mover",
        "    mientras HayFlorEnLaEsquina",
        "      tomarFlor",
        "  fin",
        "  proceso JuntarPapelesCalle",
        "  comenzar",
        "    repetir 99",
        "      mientras HayPapelEnLaEsquina",
        "        tomarPapel",
        "      mover",
        "    mientras HayPapelEnLaEsquina",
        "      tomarPapel",
        "  fin",
        "areas",
        "  ciudad: AreaC(1,1,100,100)",
        "robots",
        "  robot robot1",
        "  variables",
        "    i: numero",
        "  comenzar",
        "    i := 1",
        "    repetir 100",
        "      Pos(i,1)",
        "      JuntarFloresAvenida",
        "      derecha",
        "      Pos(1,i)",
        "      JuntarPapelesCalle",
        "      repetir 3",
        "        derecha",
        "      i := i + 1",
        "  fin",
        "variables",
        "  R-info: robot1",
        "comenzar",
        "  AsignarArea(R-info,ciudad)",
        "  Iniciar(R-info,1,1)",
        "fin"
      ],
      "notas": "Sin parámetros todavía: el número de avenida y calle lo maneja el robot con una variable y Pos."
    },
    {
      "id": "c5-09a",
      "modulo": "practicar",
      "tipo": "programa",
      "titulo": "Juntar 30 flores en una avenida (existen)",
      "tema": "procesos",
      "dificultad": 2,
      "tiempoSugeridoMin": 15,
      "enunciado": "Implemente un proceso para que el robot recorra una avenida juntando flores y se detenga cuando haya juntado 30 flores (seguro existe dicha cantidad). Usalo en la avenida 1.",
      "escenarios": [
        {
          "aleatorio": {
            "zona": [
              1,
              1,
              1,
              100
            ],
            "flores": [
              0,
              2
            ],
            "restricciones": [
              {
                "zona": [
                  1,
                  1,
                  1,
                  100
                ],
                "totalFlores": {
                  "min": 30
                }
              }
            ]
          }
        }
      ],
      "validaciones": {
        "compararConReferencia": [
          "posicionFinal",
          "bolsa"
        ],
        "usa": {
          "procesosMin": 1
        }
      },
      "solucion": [
        "programa Cap5Ej9a",
        "procesos",
        "  proceso Juntar30",
        "  variables",
        "    cant: numero",
        "  comenzar",
        "    cant := 0",
        "    mientras cant < 30",
        "      mientras HayFlorEnLaEsquina & (cant < 30)",
        "        tomarFlor",
        "        cant := cant + 1",
        "      si cant < 30",
        "        mover",
        "  fin",
        "areas",
        "  ciudad: AreaC(1,1,100,100)",
        "robots",
        "  robot robot1",
        "  comenzar",
        "    Juntar30",
        "  fin",
        "variables",
        "  R-info: robot1",
        "comenzar",
        "  AsignarArea(R-info,ciudad)",
        "  Iniciar(R-info,1,1)",
        "fin"
      ]
    },
    {
      "id": "c5-09b",
      "modulo": "practicar",
      "tipo": "programa",
      "titulo": "Juntar 30 flores en una avenida (pueden no existir)",
      "tema": "procesos",
      "dificultad": 3,
      "tiempoSugeridoMin": 15,
      "enunciado": "Modifique el proceso anterior sabiendo que las 30 flores pueden no existir.",
      "escenarios": [
        {
          "aleatorio": {
            "zona": [
              1,
              1,
              1,
              100
            ],
            "flores": [
              0,
              2
            ],
            "restricciones": [
              {
                "zona": [

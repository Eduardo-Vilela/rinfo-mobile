              1,
              1,
              6,
              4
            ],
            "flores": [
              0,
              2
            ],
            "papeles": [
              0,
              2
            ]
          }
        }
      ],
      "validaciones": {
        "compararConReferencia": [
          "ciudad",
          "recorrido"
        ],
        "usa": {
          "procesosMin": 2
        }
      },
      "solucion": [
        "programa Cap5Ej7c",
        "procesos",
        "  proceso LimpiarEsquina",
        "  comenzar",
        "    mientras HayFlorEnLaEsquina",
        "      tomarFlor",
        "    mientras HayPapelEnLaEsquina",
        "      tomarPapel",
        "  fin",
        "  proceso Izquierda",
        "  comenzar",
        "    repetir 3",
        "      derecha",
        "  fin",
        "  proceso RectanguloLimpiando",
        "  comenzar",
        "    derecha",
        "    repetir 2",
        "      repetir 5",

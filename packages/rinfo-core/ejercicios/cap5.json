        "programa Cap5Ej9c",
        "procesos",
        "  proceso Juntar30",
        "  variables",
        "    cant: numero",
        "  comenzar",
        "    cant := 0",
        "    mientras cant < 30",
        "      mientras HayFlorEnLaEsquina & (cant < 30)",
        "        tomarFlor",
        "        cant := cant + 1",
        "      si cant < 30",
        "        mover",
        "  fin",
        "areas",
        "  ciudad: AreaC(1,1,100,100)",
        "robots",
        "  robot robot1",
        "  variables",
        "    a: numero",
        "  comenzar",
        "    a := 1",
        "    repetir 100",
        "      Pos(a,1)",
        "      Juntar30",
        "      a := a + 1",
        "  fin",
        "variables",
        "  R-info: robot1",
        "comenzar",
        "  AsignarArea(R-info,ciudad)",
        "  Iniciar(R-info,1,1)",
        "fin"
      ]
